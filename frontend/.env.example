# Where the Express backend is running.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AUTH_COOKIE_NAME=admin_token
NEXT_PUBLIC_ADMIN_TIMEZONE=America/Toronto
NEXT_PUBLIC_ADMIN_NAME=Olamide
NEXT_PUBLIC_ADMIN_AVATAR=/olamide.png

# The public address of the live site. Used for canonical URLs, sitemap.xml,
# robots.txt and social previews. Defaults to https://olamideandrew.com.
NEXT_PUBLIC_SITE_URL=https://olamideandrew.com

# Google Search Console verification token (the content="" value of the
# "HTML tag" method). Optional; leave blank if verifying by DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
