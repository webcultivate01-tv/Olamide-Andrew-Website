# Where the Express backend is running.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Must match AUTH_COOKIE_NAME in backend/.env. proxy.js looks for this cookie
# to decide whether to let someone through to an admin page.
NEXT_PUBLIC_AUTH_COOKIE_NAME=admin_token

# Which clock the admin header runs on. Any of the Canadian zones listed in
# lib/admin-config.js: America/St_Johns, America/Halifax, America/Toronto,
# America/Winnipeg, America/Regina, America/Edmonton, America/Vancouver.
NEXT_PUBLIC_ADMIN_TIMEZONE=America/Toronto

# Name and photo shown for the signed-in admin. The admins table has no column
# for either yet, so these stand in until it does.
NEXT_PUBLIC_ADMIN_NAME=Olamide
NEXT_PUBLIC_ADMIN_AVATAR=/olamide.png
