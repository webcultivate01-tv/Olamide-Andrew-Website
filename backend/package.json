{
  "name": "olamide-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Admin authentication + enquiry API - Node.js + Express + MySQL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "dev:sqlite": "node --watch --import ./dev-sqlite/hooks.mjs server.js",
    "start": "node server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed/admin.seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed:case-studies && npm run db:seed:categories",
    "db:seed:case-studies": "node database/seed/case-studies.seed.js",
    "db:seed:categories": "node database/seed/categories.seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.24.2",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
