# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Set to true ONLY when the API runs behind a reverse proxy (nginx, a host's
# router). Leave it false otherwise, or a client can fake its IP and skip the
# rate limits.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# MySQL (local development)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=admin_auth_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# ---------------------------------------------------------------------------
# Tokens
# Make each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1d

RESET_TOKEN_SECRET=replace_me_with_a_different_long_random_string
RESET_TOKEN_EXPIRES_IN=15m

AUTH_COOKIE_NAME=admin_token
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# OTP rules
# ---------------------------------------------------------------------------
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Email (Nodemailer)
# Leave MAIL_HOST and MAIL_USER empty during development and the OTP is
# printed in the backend terminal instead of being emailed.
# For Gmail, use a Google App Password, not your normal password.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Admin System <no-reply@localhost>

# ---------------------------------------------------------------------------
# The only origin allowed to call this API.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
